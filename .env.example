# ─────────────────────────────────────────────────
# Forex Bot — Environment Variables Template
# Copy to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────

# ── MetaTrader5 ──────────────────────────────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=VantageFX-Demo
# Full path to terminal64.exe inside your Wine prefix
MT5_PATH=/root/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe

# ── MySQL ─────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=fxbot
MYSQL_USER=root
MYSQL_PASSWORD=

# ── Telegram ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=e5362baf-c777-4d57-a609-6eaf1f9e87f6
TELEGRAM_CHAT_ID=7667248978

# ── Safety Guard ─────────────────────────────────
# Set to true ONLY after 4+ weeks demo validation and explicit review
LIVE_TRADING_ENABLED=false
